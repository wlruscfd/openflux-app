*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
/build/
/captures/
.externalNativeBuild/
.cxx/
*.keystore
*.jks

# Release signing key + its passwords - never commit this. Losing it means
# every future release must ship under a new signature, which Android
# treats as a different app (no seamless update over an existing install).
/keystore/

# Generated by ../build_android_aar.sh from the Go `mobile` package -
# not checked in, same as any other compiled binary.
app/libs/*.aar
app/libs/*-sources.jar

app/build/

.kotlin/
