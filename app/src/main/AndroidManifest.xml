<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required by ConnectivityManager.registerNetworkCallback
         (OpenFluxVpnService's network-change-triggered reconnect) - without
         it that call throws SecurityException at runtime, silently caught by
         its own runCatching, so the whole feature quietly never worked
         rather than crashing visibly. Normal-level, granted automatically at
         install, no runtime request needed. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Only requested when the user picks "scan QR code" in the profiles
         tab (a user-initiated, optional action - see QrScanScreen.kt). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Only used to launch ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS from
         Settings (a user-initiated, optional action - see SettingsScreen's
         "ignore battery optimizations" button) - never requested silently. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".OpenFluxApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.OpenFlux"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.OpenFlux"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Profile import links: openflux://import?data=<base64url-json>,
                 see ProfileDeepLink.kt. BROWSABLE so a link on a web page or
                 in another app can open it directly. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="openflux" android:host="import" />
            </intent-filter>
        </activity>

        <service
            android:name=".vpn.OpenFluxVpnService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Local SOCKS5 proxy mode (OpenFluxSocks5Service) - no VpnService,
             no TUN, no BIND_VPN_SERVICE: this is a plain foreground service
             that only listens on 127.0.0.1, so it needs none of
             .vpn.OpenFluxVpnService's special permission/intent-filter. -->
        <service
            android:name=".vpn.OpenFluxSocks5Service"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="socks5-proxy" />
        </service>

        <!-- Quick Settings tile (Settings > Quick Settings, next to Wi-Fi/
             Bluetooth/flashlight) - toggles the active profile's connection.
             android:icon is required here for pre-Android 12 launchers to
             show the tile in the "add tile" picker at all. -->
        <service
            android:name=".vpn.OpenFluxTileService"
            android:exported="true"
            android:icon="@drawable/ic_power"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
